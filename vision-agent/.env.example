# Same Stream project as the parent Expo app's .env - the agent joins calls
# created by src/app/api/stream/call+api.ts, so these must match.
STREAM_API_KEY=
STREAM_API_SECRET=

# OpenAI Realtime (voice-only AI teacher LLM).
OPENAI_API_KEY=

# Shared secret the Expo API routes send as the X-Agent-Secret header. Must be
# the same value as AGENT_SHARED_SECRET in the parent app's .env. Required once
# this service is reachable from the internet - without it anyone who finds the
# URL can spawn OpenAI Realtime sessions on the key above. Leave blank for
# localhost-only development and the check is skipped (with a warning).
# Generate one with: openssl rand -hex 32
AGENT_SHARED_SECRET=
