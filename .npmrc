# @config-plugins/react-native-webrtc@15.0.1 still declares `peer expo@^56` while
# this project runs Expo 57, so every npm install in this repo hits ERESOLVE. The
# package is build-time only (it just edits Info.plist / AndroidManifest.xml at
# prebuild), so accepting the mismatch is safe - downgrading Expo is not.
#
# This lives in .npmrc rather than as a CLI flag because Vercel's @vercel/node
# builder runs its own `npm install` for api/index.ts *after* the build, and that
# one ignores vercel.json's installCommand. Only config reaches both.
legacy-peer-deps=true
